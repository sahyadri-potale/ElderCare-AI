PORT=5001
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
GEMINI_API_KEY=your_google_ai_studio_api_key
# Google Cloud Text-to-Speech (enable the API and billing on this project).
# Keep the service-account JSON outside this repository and grant it access to
# Cloud Text-to-Speech. For local development, ADC also works:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/tts-service-account.json
# Optional if the project cannot be inferred from the credentials:
# GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
